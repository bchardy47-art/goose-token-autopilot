<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bchardy.token-grab-learning</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/brianhardy/goose-token-autopilot/scripts/run-token-grab-learning-cron.sh</string>
  </array>

  <!-- Run every 30 minutes -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>/Users/brianhardy/goose-token-autopilot/logs/token-grab-learning/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/brianhardy/goose-token-autopilot/logs/token-grab-learning/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>

  <!--
    PATH must include the NVM-managed node/npm binaries. launchd does NOT
    source ~/.bashrc or ~/.zshrc, so NVM is not on PATH by default.

    Run `which node` in your terminal to get the exact path, then set:
      /Users/brianhardy/.nvm/versions/node/<version>/bin

    Current node version on this machine: v22.22.2
    Update the PATH below when you upgrade node via nvm.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/brianhardy/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
